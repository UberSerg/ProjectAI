# Application
APP_ENV=development
APP_NAME=ProjectAI
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend (browser -> host-mapped backend)
VITE_API_BASE_URL=http://localhost:8000

# Core PostgreSQL (operational DB)
CORE_DATABASE_HOST=postgres-core
CORE_DATABASE_PORT=5432
CORE_DATABASE_NAME=projectai_core
CORE_DATABASE_USER=projectai
CORE_DATABASE_PASSWORD=projectai_core_change_me

# Memory PostgreSQL (Decision Memory + pgvector)
MEMORY_DATABASE_HOST=postgres-memory
MEMORY_DATABASE_PORT=5432
MEMORY_DATABASE_NAME=projectai_memory
MEMORY_DATABASE_USER=projectai
MEMORY_DATABASE_PASSWORD=projectai_memory_change_me

# Redis (Celery broker/backend + cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Polza LLM (do not commit real secrets)
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/v1
POLZA_DEFAULT_MODEL=

# Host-published ports (docker compose)
HOST_FRONTEND_PORT=5173
HOST_BACKEND_PORT=8000
HOST_CORE_DB_PORT=5432
HOST_MEMORY_DB_PORT=5433
HOST_REDIS_PORT=6379
