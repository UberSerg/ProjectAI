# Image-only frontend for release validation / future 24/7 host.
# Not used by everyday bind-mounted `docker compose` development.

FROM node:22-bookworm-slim AS build

WORKDIR /app

ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_KRAKEN_VERSION=1.0.0
ARG VITE_GIT_SHA=
ARG VITE_BUILD_TIME=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_KRAKEN_VERSION=$VITE_KRAKEN_VERSION \
    VITE_GIT_SHA=$VITE_GIT_SHA \
    VITE_BUILD_TIME=$VITE_BUILD_TIME

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.release.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173
HEALTHCHECK --interval=10s --timeout=5s --retries=20 --start-period=10s \
  CMD wget -qO- http://127.0.0.1:5173/ >/dev/null || exit 1
